{
  "name": "vntest-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript Automation Framework for VNTEST",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test src/tests/auth",
    "test:slow": "SLOW_MO=600 playwright test src/tests/auth --headed",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "page-object-model"
  ],
  "author": "ThaiHD",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.1",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}

