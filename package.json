{
  "name": "vntest-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript Automation Framework for VNTEST",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headless": "HEADLESS=true playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test src/tests/auth",
    "test:auth:critical": "playwright test src/tests/auth --grep \"@critical\"",
    "test:auth:high": "playwright test src/tests/auth --grep \"@high\"",
    "test:leads": "playwright test src/tests/leads",
    "test:leads:critical": "playwright test src/tests/leads --grep \"@critical\"",
    "test:leads:high": "playwright test src/tests/leads --grep \"@high\"",
    "test:customers": "playwright test src/tests/customers",
    "test:customers:critical": "playwright test src/tests/customers --grep \"@critical\"",
    "test:customers:high": "playwright test src/tests/customers --grep \"@high\"",
    "test:partners": "playwright test src/tests/partners",
    "test:partners:critical": "playwright test src/tests/partners --grep \"@critical\"",
    "test:partners:high": "playwright test src/tests/partners --grep \"@high\"",
    "test:collaborators": "playwright test src/tests/collaborators",
    "test:collaborators:critical": "playwright test src/tests/collaborators --grep \"@critical\"",
    "test:collaborators:high": "playwright test src/tests/collaborators --grep \"@high\"",
    "test:single-criteria": "playwright test src/tests/single-criteria",
    "test:single-criteria:critical": "playwright test src/tests/single-criteria --grep \"@critical\"",
    "test:single-criteria:high": "playwright test src/tests/single-criteria --grep \"@high\"",
    "test:formula": "playwright test src/tests/formula",
    "test:formula:critical": "playwright test src/tests/formula --grep \"@critical\"",
    "test:formula:high": "playwright test src/tests/formula --grep \"@high\"",
    "test:personnel": "playwright test src/tests/personnel",
    "test:personnel:critical": "playwright test src/tests/personnel --grep \"@critical\"",
    "test:personnel:high": "playwright test src/tests/personnel --grep \"@high\"",
    "test:ho-so-tn": "playwright test src/tests/ho-so-tn",
    "test:ho-so-tn:critical": "playwright test src/tests/ho-so-tn --grep \"@critical\"",
    "test:ho-so-tn:high": "playwright test src/tests/ho-so-tn --grep \"@high\"",
    "test:truong-bp-ktra": "playwright test src/tests/truong-bp-ktra",
    "test:truong-bp-ktra:critical": "playwright test src/tests/truong-bp-ktra --grep \"@critical\"",
    "test:truong-bp-ktra:high": "playwright test src/tests/truong-bp-ktra --grep \"@high\"",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "page-object-model"
  ],
  "author": "ThaiHD",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.1",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}

